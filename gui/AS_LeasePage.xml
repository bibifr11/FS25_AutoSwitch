<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- AutoSwitch : onglet « Location » du menu Échap (scripts/FieldLease.lua) -->
<GUI name="asLeaseFrame">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="asLeaseHeaderIcon" id="headerIcon" size="50px 50px"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerText" text="" size="700px 32px"/>
            <!-- encadré en haut à droite « Mon locatif » : champs possédés, pris en location, loués -->
            <Bitmap profile="asLeaseCountBox" id="countBox" position="-10px 0px" size="460px 104px">
                <Text profile="asLeaseListTitle" id="countTitle" position="16px -4px" size="430px 24px" text=""/>
                <Text profile="asLeaseCountText" id="countOwned" position="16px -28px" size="430px 24px" text=""/>
                <Text profile="asLeaseCountText" id="countTaken" position="16px -52px" size="430px 24px" text=""/>
                <Text profile="asLeaseCountText" id="countLeased" position="16px -76px" size="430px 24px" text=""/>
            </Bitmap>
        </GuiElement>

        <GuiElement id="contentView">
            <GuiElement id="tableContainer">
                <!-- en haut à gauche : carte étirée vers la droite (dessinée par le script), champ choisi à droite -->
                <Bitmap profile="asLeaseMapBox" id="miniMap" position="0px -10px" size="860px 290px"/>
                <Text profile="asLeaseInfoTitle" id="infoName" position="890px -20px" size="460px 34px" text=""/>
