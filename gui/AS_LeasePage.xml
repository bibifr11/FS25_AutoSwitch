                <!-- 2 x 2 : à gauche Mes propriétés (Mes champs, Mes locations), à droite Mes voisins
                     (Annonces des voisins, Champs loués) -->
                <Text profile="asLeaseGroupTitle" id="groupMine" position="0px -312px" size="664px 30px" text=""/>
                <Text profile="asLeaseGroupTitle" id="groupNeighbours" position="684px -312px" size="664px 30px" text=""/>

                <Text profile="asLeaseListTitle" id="titleOwn" position="0px -348px" size="664px 26px" text=""/>
                <Text profile="asLeaseListTitle" id="titleOffer" position="684px -348px" size="664px 26px" text=""/>
